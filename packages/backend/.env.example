# Backend Environment Variables
PORT=3001
NODE_ENV=development

# Database (optional for dev - uses in-memory store)
DATABASE_URL=postgresql://user:password@localhost:5432/reelroom

# Redis (optional for dev - uses in-memory store)
REDIS_URL=redis://localhost:6379

# JWT Secret for session tokens
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS Origin
CORS_ORIGIN=http://localhost:5173

# Instagram oEmbed (uses public API, no key needed)
INSTAGRAM_OEMBED_URL=https://graph.facebook.com/v18.0/instagram_oembed

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
